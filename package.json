{
  "name": "group-expense-splitter",
  "version": "1.0.0",
  "description": "Full-Stack Group Expense Splitter with integer-paise precision and debt simplification",
  "main": "server/src/server.js",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "seed": "cd server && npm run seed",
    "test": "cd server && npm run test",
    "build": "cd client && npm install && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "splitwise",
    "expense-splitter",
    "mern",
    "fintech"
  ],
  "author": "",
  "license": "MIT"
}
